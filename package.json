{
  "name": "frostcode",
  "version": "0.1.0",
  "description": "FrostCode — an interactive terminal coding assistant built on the Claude Agent SDK, billed to your Anthropic API key.",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-gui.mjs --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json",
    "test": "vitest run",
    "dev": "tsx src/cli.tsx",
    "e2e": "bash scripts/e2e.sh",
    "prepare": "npm run build",
    "smoke": "tsx scripts/smoke.ts",
    "gui": "npm run build && node bin/frostcode.js gui --wait",
    "install-app": "npm run build && node scripts/install-app.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@anthropic-ai/sdk": "^1.3.0",
    "chalk": "^5.6.2",
    "diff": "^9.0.0",
    "ink": "^6.8.0",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "type": "module",
  "bin": {
    "frostcode": "bin/frostcode.js"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "optionalDependencies": {
    "electron": "^39.8.10"
  }
}
